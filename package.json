{
  "name": "whittle",
  "version": "0.1.0",
  "description": "Make coding agents read less. A local proxy and CLI that compresses logs, test output, JSON and diffs before the model sees them, with a dashboard that shows exactly what was cut.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "whittle": "bin/whittle.mjs"
  },
  "scripts": {
    "dev": "next dev -p 4317",
    "build": "next build",
    "start": "next start -p 4317",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "gpt-tokenizer": "^4.1.0",
    "next": "^16.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
